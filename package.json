{
  "name": "struct-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:test": "node tools/clean-test-output.mjs && tsc --outDir dist",
    "test": "npm run build:test && node tools/run-tests.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "build": "node tools/build-bundle.mjs",
    "docs-lint": "node bin/docs-lint.mjs",
    "rehearse:execution": "node tools/rehearsal/create.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@stylistic/eslint-plugin": "4.4.1",
    "@types/node": "22.20.5",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.0"
  },
  "dependencies": {
    "commander": "13.1.0",
    "yaml": "2.9.1"
  },
  "bin": {
    "docs-lint": "bin/docs-lint.mjs"
  }
}
