{
  "struct-docs": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/post-write-check.mjs",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/stop-repair.mjs",
        "timeout": 60
      }
    ]
  }
}
